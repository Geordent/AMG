+  catalog.exploreIdx = catalog.sites.map(f => {
+    const p = f.properties, arts = catalog.artworksBySite.get(p.id) || [];
+    const values = [];
+    const add = o => { for (const v of searchValues(o)) if (v) values.push(v); };
+    add(p.name); add(p.address); add(p.description); add(catalog.cities.get(p.city));
+    add(arts[0] && arts[0].title); add(arts[0] && arts[0].description);
+    for (const a of arts.slice(0, 3)) for (const id of (a.artist_ids || [])) {
+      const artist = catalog.artists.get(id); if (artist) add(artist.name);
+    }
+    return { id:p.id, cat:siteCat(p, arts), city:p.city || '', text:' ' + searchNorm(values.join(' | ')) };
+  });
+  return catalog.exploreIdx;
+}
