+    {"type": "Feature", "geometry": {"type": "Point", "coordinates": [45.5669873, 41.8963704]}, "properties": {"id": "site-0585", "city": "telavi", "name": {"en": "Aleksandre Chavchavadze House Museum in Tsinandali", "ru": "Дом-музей Александра Чавчавадзе в Цинандали", "ka": "წინანდლის ალექსანდრე ჭავჭავაძის სახლ-მუზეუმი"}, "address": {"en": "Tsinandali, Telavi Municipality, Kakheti", "ru": "Цинандали, Телавский муниципалитет, Кахетия", "ka": "წინანდალი, თელავის მუნიციპალიტეტი, კახეთი"}, "precision": "building", "access": "public", "access_note": {"ru": "Практические условия посещения не подтверждены; уточните часы и правила на месте.", "en": "Practical visiting conditions are unconfirmed; check hours and rules locally.", "ka": "ვიზიტის პრაქტიკული პირობები დაუზუსტებელია; საათები და წესები ადგილზე გადაამოწმეთ."}, "visible_from_outside": true, "topic": "heritage", "poi_kind": "museum", "description": {"en": "The Aleksandre Chavchavadze House Museum in Tsinandali is a 19th-century estate with period interiors, a historic library and a wine cellar. It links Kakhetian winemaking with the literary and aristocratic history of the Chavchavadze family. The park and exhibitions are the main draw; opening hours still need confirmation.", "ru": "Дом-музей Александра Чавчавадзе в Цинандали — усадьба XIX века с историческими интерьерами, библиотекой и винным погребом. Здесь соединяются литературная история, дворянский быт и кахетинское виноделие; стоит обратить внимание на парк и экспозицию о семье Чавчавадзе. Часы и формат посещения нужно уточнить.", "ka": "წინანდლის ალექსანდრე ჭავჭავაძის სახლ-მუზეუმი XIX საუკუნის მამულია ისტორიული ინტერიერებით, ბიბლიოთეკითა და ღვინის მარანით. აქ ერთმანეთს ხვდება ლიტერატურული ისტორია, აზნაურთა ყოფა და კახური მეღვინეობა; ყურადღება მიაქციეთ პარკსა და ჭავჭავაძეების ოჯახის ექსპოზიციას. ვიზიტის საათები და ფორმატი ჯერ დასაზუსტებელია."}, "sources": [{"id": "src-0027", "role": "identity"}, {"id": "src-0027", "role": "coordinates"}, {"id": "src-0027", "role": "description"}, {"id": "src-0027", "role": "tourism"}], "origin": "manual", "updated": "2026-10-29"}},
